<ContentDialog
    x:Class="AllLive.UWP.Controls.DouyuLoginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="登录斗鱼"
    PrimaryButtonText="刷新二维码"
    SecondaryButtonText="关闭"
    PrimaryButtonClick="Refresh_Click">
    <StackPanel Spacing="12" MaxWidth="320">
        <Grid Width="260" Height="260" Background="White" HorizontalAlignment="Center">
            <Image x:Name="QrImage" Stretch="Uniform" />
            <ProgressRing x:Name="BusyRing" Width="40" Height="40" IsActive="False" />
        </Grid>
        <TextBlock Text="请使用斗鱼 App 扫码，并在手机上确认登录。" TextWrapping="Wrap" TextAlignment="Center" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</ContentDialog>
